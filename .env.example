# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Database ---------------------------------------------------------
DATABASE_URL=postgres://mwezicare:mwezicare@localhost:5432/mwezicare

# --- Auth (Better Auth) -------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Conversational assistant (LLM via Vercel AI SDK + AI Gateway) ------
# https://vercel.com/docs/ai-gateway — one key routes to any provider/model.
AI_GATEWAY_API_KEY=
# Optional overrides — defaults match the pgvector column's dimensionality
# (vector(1536), see packages/db/src/schema/custom-types.ts).
ASSISTANT_CHAT_MODEL=openai/gpt-4o-mini
ASSISTANT_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Field-level encryption (packages/db/crypto) -------------------------
# JSON object of keyId -> base64-encoded 32-byte key, e.g. {"1":"<base64>"}.
# In dev, one entry; in production, a cloud-KMS-backed key reference per id.
# Generate a dev key with: openssl rand -base64 32
ENCRYPTION_KEYS={"1":""}
# Which entry in ENCRYPTION_KEYS is current (used for new encryptions).
# After a key rotation, keep the old id in ENCRYPTION_KEYS until
# worker/jobs/reencrypt.ts has re-written existing rows under the new one.
ENCRYPTION_KEY_ID=1
# Separate key for the HMAC lookup hash (phone/email lookups) — must not
# reuse any ENCRYPTION_KEYS entry. Generate with: openssl rand -base64 32
HMAC_LOOKUP_KEY=
# Separate key for analytics.events.pseudo_id — must not reuse
# HMAC_LOOKUP_KEY or ENCRYPTION_KEYS. Generate with: openssl rand -base64 32
ANALYTICS_KEY=

# --- Facility import (packages/facilities) -------------------------------
# Only needed to run the KMHFL API adapter (the CSV/GeoJSON file adapter and
# `pnpm facilities:import -- --file <path>` don't need these).
KMHFL_API_BASE_URL=
KMHFL_API_KEY=

# --- Object storage (clinician-summary PDFs) ------------------------------
# Garage (S3-compatible) in dev — see docker-compose.yml's garage/garage-init
# services and infra/garage/garage.toml. (Not MinIO: the official minio/minio
# image is no longer pullable without a registry login.) The access
# key/secret below are the fixed dev values garage-init imports.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=GK5eb64026e220127625db8902
S3_SECRET_KEY=57be0cdd2ca907f9d91ca8c1e74f63f4bfdf210ebd61cf2c0a7ab0b353bb6d30
S3_BUCKET=mwezicare-summaries
S3_REGION=garage

# --- Observability (F1 spec) ----------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Performance tracing is OFF (0) by default — see packages/validation/src/env.ts.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Retention jobs (worker/jobs/retention.ts) -----------------------------
# [LEGAL REVIEW REQUIRED] every default below is a placeholder period, not a
# counsel-approved retention schedule.
CHAT_RETENTION_DAYS=90
SHARE_LINK_RETENTION_DAYS=7
ACCOUNT_PURGE_DAYS=30
AUDIT_RETENTION_DAYS=365

# --- Client-safe ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
